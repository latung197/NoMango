<Window x:Class="ERP_System.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ERP_System.Converters"
        Title="Hệ thống ERP" 
        Height="768" Width="1024"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

        <Style x:Key="MenuToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#34495E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MenuItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#34495E"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3498DB"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#34495E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="0,0,10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo and Menu Toggle -->
                <Border Grid.Column="0" Background="#3498DB" Width="60">
                    <ToggleButton x:Name="btnMenuToggle" Style="{StaticResource MenuToggleButtonStyle}">
                        <TextBlock Text="☰" FontSize="16" Foreground="White" FontWeight="Bold"/>
                    </ToggleButton>
                </Border>

                <!-- Search Box -->
                <Border Grid.Column="1" Padding="20,0" VerticalAlignment="Center">
                    <TextBox x:Name="txtSearch" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            Padding="15,8" FontSize="13" BorderThickness="1" BorderBrush="#BDC3C7"
                            KeyDown="TxtSearch_KeyDown">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="BorderBrush" Value="#3498DB"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Border>

                <!-- Notifications -->
                <Border Grid.Column="2" Padding="10,0">
                    <Button x:Name="btnNotifications" Style="{StaticResource HeaderButtonStyle}"
                           Click="BtnNotifications_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔔" FontSize="16" VerticalAlignment="Center"/>
                            <Border Background="#E74C3C" CornerRadius="7" Padding="3,1" 
                                   Margin="5,0,0,0" VerticalAlignment="Top"
                                   Visibility="{Binding Notifications.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                <TextBlock Text="{Binding Notifications.Count}" FontSize="9" 
                                          Foreground="White" FontWeight="Bold" 
                                          HorizontalAlignment="Center" MinWidth="10"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </Border>

                <!-- Language Selector -->
                <ComboBox Grid.Column="3" Width="120" Height="30" VerticalAlignment="Center"
                         FontSize="12" SelectedIndex="0" Margin="10,0"
                         Background="#34495E" Foreground="White" BorderThickness="0">
                    <ComboBoxItem Content="🇻🇳 Tiếng Việt"/>
                    <ComboBoxItem Content="🇺🇸 English"/>
                </ComboBox>

                <!-- User Info -->
                <Border Grid.Column="4" Padding="10,0">
                    <Button x:Name="btnUserMenu" Style="{StaticResource HeaderButtonStyle}"
                           Click="BtnUserMenu_Click">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#3498DB" Width="32" Height="32" CornerRadius="16">
                                <TextBlock Text="👤" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentUser.FullName}" FontSize="12" 
                                          Foreground="White" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CurrentUser.CompanyName}" FontSize="10" 
                                          Foreground="#BDC3C7"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" x:Name="sidebarColumn"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar Menu -->
            <Border Grid.Column="0" Background="#2C3E50" x:Name="sidebar">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Menu Items -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="menuItemsControl" ItemsSource="{Binding MenuItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Header="{Binding MenuName}" IsExpanded="True"
                                             Background="Transparent" Foreground="White"
                                             BorderThickness="0" FontSize="13"
                                             Margin="5">
                                        <ListBox ItemsSource="{Binding Children}" 
                                                ItemContainerStyle="{StaticResource MenuItemStyle}"
                                                Background="Transparent" BorderThickness="0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding MenuName}" Padding="5,8"
                                                              MouseLeftButtonUp="MenuTextBlock_MouseLeftButtonUp"
                                                              Cursor="Hand"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- DateTime and Company -->
                    <Border Grid.Row="1" Background="#34495E" Padding="15,10">
                        <StackPanel>
                            <TextBlock x:Name="txtDateTime" Foreground="#BDC3C7" FontSize="11"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentUser.CompanyName}" Foreground="#BDC3C7" 
                                      FontSize="10" HorizontalAlignment="Center" 
                                      TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Border Grid.Column="1" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Loading Indicator -->
                    <ProgressBar Grid.Row="0" Height="4" IsIndeterminate="True" 
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <!-- Status Message -->
                    <TextBlock Grid.Row="0" Text="{Binding StatusMessage}" 
                              Foreground="#3498DB" FontSize="11" FontWeight="SemiBold"
                              Margin="10,5" HorizontalAlignment="Left"
                              Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                    <!-- Main Content -->
                    <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="#34495E" Foreground="White">
            <StatusBarItem>
                <TextBlock Text="Sẵn sàng"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="ERP System v1.0 | © 2024"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>