<UserControl x:Class="ERP_System.Views.Inventory.StockRequestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <UserControl.Resources>
        <Style x:Key="FormButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2980B9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#3498DB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DetailButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="PHIẾU YÊU CẦU XUẤT KHO" FontSize="18" FontWeight="Bold" 
                      Foreground="#2C3E50"/>
            <TextBlock Text="Quản lý phiếu yêu cầu xuất kho trong hệ thống" 
                      FontSize="12" Foreground="#6C757D" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Main Toolbar -->
        <Border Grid.Row="1" Background="#F8F9FA" Padding="15" Margin="0,15,0,10" CornerRadius="5">
            <StackPanel Orientation="Horizontal">
                <Button Content="📝 Tạo mới" Style="{StaticResource FormButtonStyle}"
                       Background="#27AE60" Command="{Binding NewCommand}"/>
                <Button Content="💾 Lưu" Style="{StaticResource FormButtonStyle}"
                       Command="{Binding SaveCommand}"/>
                <Button Content="✅ Duyệt" Style="{StaticResource FormButtonStyle}"
                       Background="#27AE60" Command="{Binding ApproveCommand}"/>
                <Button Content="🗑️ Xóa" Style="{StaticResource FormButtonStyle}"
                       Background="#E74C3C" Command="{Binding DeleteCommand}"/>
                <Button Content="🔄 Làm mới" Style="{StaticResource FormButtonStyle}"
                       Background="#95A5A6" Command="{Binding RefreshCommand}"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- Request List -->
            <Border Grid.Column="0" Background="White" BorderBrush="#DEE2E6" BorderThickness="1" 
                   Margin="0,0,10,0" CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="DANH SÁCH PHIẾU YÊU CẦU" FontWeight="SemiBold" 
                              Foreground="#2C3E50" Margin="10" FontSize="14"/>

                    <DataGrid Grid.Row="1" 
                             ItemsSource="{Binding StockRequests}"
                             SelectedItem="{Binding SelectedRequest}"
                             AutoGenerateColumns="False" 
                             CanUserAddRows="False" 
                             IsReadOnly="True"
                             SelectionMode="Single"
                             Background="White"
                             BorderThickness="0">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã phiếu" Binding="{Binding RequestCode}" 
                                               Width="80" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Ngày" Binding="{Binding RequestDate, StringFormat=dd/MM/yyyy}" 
                                               Width="80"/>
                            <DataGridTextColumn Header="Kho" Binding="{Binding WarehouseName}" 
                                               Width="120"/>
                            <DataGridTextColumn Header="Số lượng" Binding="{Binding TotalQuantity, StringFormat=N0}" 
                                               Width="70"/>
                            <DataGridTextColumn Header="Trị giá" Binding="{Binding TotalValue, StringFormat=N0}" 
                                               Width="90"/>
                            <DataGridTemplateColumn Header="Trạng thái" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}" 
                                                CornerRadius="10" Padding="5,2" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" 
                                                      Foreground="White" FontSize="9" 
                                                      FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Request Details Form -->
            <Border Grid.Column="1" Background="#F8F9FA" Padding="15" CornerRadius="5">
                <ScrollViewer>
                    <StackPanel>
                        <TextBlock Text="THÔNG TIN PHIẾU" FontWeight="SemiBold" 
                                  Foreground="#2C3E50" Margin="0,0,0,10" FontSize="14"/>

                        <!-- Basic Information -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Mã phiếu *" FontWeight="SemiBold" FontSize="11" 
                                      Foreground="#2C3E50" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding CurrentRequest.RequestCode}" 
                                    Style="{StaticResource FormTextBoxStyle}" IsReadOnly="True"/>

                            <TextBlock Text="Ngày yêu cầu *" FontWeight="SemiBold" FontSize="11" 
                                      Foreground="#2C3E50" Margin="0,10,0,2"/>
                            <DatePicker SelectedDate="{Binding CurrentRequest.RequestDate}" 
                                       Height="35" FontSize="12"/>

                            <TextBlock Text="Kho xuất *" FontWeight="SemiBold" FontSize="11" 
                                      Foreground="#2C3E50" Margin="0,10,0,2"/>
                            <ComboBox Height="35" FontSize="12" 
                                     ItemsSource="{Binding AvailableWarehouses}"
                                     DisplayMemberPath="WarehouseName"
                                     SelectedValuePath="WarehouseID"
                                     SelectedValue="{Binding CurrentRequest.WarehouseID}"/>

                            <TextBlock Text="Phòng/Bộ phận" FontWeight="SemiBold" FontSize="11" 
                                      Foreground="#2C3E50" Margin="0,10,0,2"/>
                            <TextBox Text="{Binding CurrentRequest.Department}" 
                                    Style="{StaticResource FormTextBoxStyle}"/>

                            <TextBlock Text="Lý do" FontWeight="SemiBold" FontSize="11" 
                                      Foreground="#2C3E50" Margin="0,10,0,2"/>
                            <TextBox Text="{Binding CurrentRequest.Reason}" 
                                    Style="{StaticResource FormTextBoxStyle}" Height="60" 
                                    TextWrapping="Wrap" AcceptsReturn="True"/>
                        </StackPanel>

                        <!-- Detail Section -->
                        <Border Background="White" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="CHI TIẾT VẬT TƯ" FontWeight="SemiBold" 
                                              Foreground="#2C3E50" FontSize="12"/>
                                    <Button Content="➕ Thêm dòng" Style="{StaticResource DetailButtonStyle}"
                                           Command="{Binding AddDetailCommand}"
                                           Margin="10,0,0,0" Foreground="#3498DB"/>
                                </StackPanel>

                                <DataGrid ItemsSource="{Binding CurrentRequest.Details}"
                                         AutoGenerateColumns="False" 
                                         CanUserAddRows="False" 
                                         IsReadOnly="True"
                                         SelectionMode="Single"
                                         Background="White"
                                         BorderThickness="0"
                                         HeadersVisibility="Column"
                                         MaxHeight="200">

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Vật tư" Binding="{Binding MaterialName}" 
                                                           Width="*"/>
                                        <DataGridTextColumn Header="SL" Binding="{Binding Quantity, StringFormat=N0}" 
                                                           Width="40"/>
                                        <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPrice, StringFormat=N0}" 
                                                           Width="60"/>
                                        <DataGridTextColumn Header="Thành tiền" Binding="{Binding TotalPrice, StringFormat=N0}" 
                                                           Width="70"/>
                                        <DataGridTemplateColumn Width="30">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="✕" Style="{StaticResource DetailButtonStyle}"
                                                           Foreground="#E74C3C" FontSize="10"
                                                           Click="RemoveDetail_Click"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Totals -->
                                <StackPanel Margin="0,10,0,0" Background="#F8F9FA" Padding="10" CornerRadius="3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Tổng số lượng:" FontWeight="SemiBold" Width="100"/>
                                        <TextBlock Text="{Binding CurrentRequest.TotalQuantity, StringFormat=N0}" 
                                                  FontWeight="SemiBold" Foreground="#3498DB"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Tổng trị giá:" FontWeight="SemiBold" Width="100"/>
                                        <TextBlock Text="{Binding CurrentRequest.TotalValue, StringFormat=N0, StringFormat='{}{0:N0} VNĐ'}" 
                                                  FontWeight="SemiBold" Foreground="#E74C3C"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Status Information -->
                        <Border Background="White" CornerRadius="5" Padding="10">
                            <StackPanel>
                                <TextBlock Text="TRẠNG THÁI" FontWeight="SemiBold" 
                                          Foreground="#2C3E50" FontSize="12" Margin="0,0,0,5"/>

                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="Trạng thái:" FontWeight="SemiBold" Width="80"/>
                                    <TextBlock Text="{Binding CurrentRequest.Status}" 
                                              Foreground="{Binding CurrentRequest.Status, Converter={StaticResource StatusToColorConverter}}"
                                              FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="Người tạo:" FontWeight="SemiBold" Width="80"/>
                                    <TextBlock Text="{Binding CurrentRequest.CreatedByName}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="Ngày tạo:" FontWeight="SemiBold" Width="80"/>
                                    <TextBlock Text="{Binding CurrentRequest.CreatedDate, StringFormat=dd/MM/yyyy HH:mm}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,2" 
                                           Visibility="{Binding CurrentRequest.ApprovedByName, Converter={StaticResource StringToVisibilityConverter}}">
                                    <TextBlock Text="Người duyệt:" FontWeight="SemiBold" Width="80"/>
                                    <TextBlock Text="{Binding CurrentRequest.ApprovedByName}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,2"
                                           Visibility="{Binding CurrentRequest.ApprovedDate, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="Ngày duyệt:" FontWeight="SemiBold" Width="80"/>
                                    <TextBlock Text="{Binding CurrentRequest.ApprovedDate, StringFormat=dd/MM/yyyy HH:mm}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="3" Background="#F8F9FA" Padding="10" Margin="0,10,0,0" CornerRadius="5">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#3498DB"/>
        </Border>
    </Grid>
</UserControl>