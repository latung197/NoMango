<Window x:Class="ERP_System.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập Hệ thống ERP" 
        Height="500" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="White">

    <Window.Resources>
        <Style x:Key="LoginButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2980B9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LoginTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#3498DB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LoginComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#3498DB" BorderThickness="2" CornerRadius="15" Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#3498DB" CornerRadius="13,13,0,0" Height="80">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🏢" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="HỆ THỐNG ERP" 
                                  Foreground="White" FontSize="18" FontWeight="Bold"
                                  HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Button Content="✕" FontSize="16" Foreground="White" 
                           Background="Transparent" BorderThickness="0"
                           HorizontalAlignment="Right" VerticalAlignment="Top"
                           Width="30" Height="30" Margin="5"
                           Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- Login Form -->
            <StackPanel Grid.Row="1" Margin="40,30" VerticalAlignment="Center">
                <TextBlock Text="Đăng nhập hệ thống" FontSize="20" FontWeight="Bold" 
                          Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <TextBlock Text="Cơ sở dữ liệu" FontWeight="SemiBold" 
                          Foreground="#2C3E50" Margin="0,0,0,5"/>
                <ComboBox x:Name="cmbDatabase" 
                         ItemsSource="{Binding Databases}"
                         DisplayMemberPath="ConnectionName"
                         SelectedItem="{Binding SelectedDatabase}"
                         Style="{StaticResource LoginComboBoxStyle}"/>

                <TextBlock Text="Tên đăng nhập" FontWeight="SemiBold" 
                          Foreground="#2C3E50" Margin="0,15,0,5"/>
                <TextBox x:Name="txtUsername" 
                        Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource LoginTextBoxStyle}"/>

                <TextBlock Text="Mật khẩu" FontWeight="SemiBold" 
                          Foreground="#2C3E50" Margin="0,15,0,5"/>
                <PasswordBox x:Name="txtPassword" 
                            PasswordChanged="TxtPassword_PasswordChanged"
                            Style="{StaticResource LoginTextBoxStyle}"/>

                <CheckBox x:Name="chkRemember" Content="Ghi nhớ đăng nhập" 
                         Margin="0,15,0,0" Foreground="#2C3E50"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,25,0,0">
                    <Button Content="ĐĂNG NHẬP" 
                           Command="{Binding LoginCommand}"
                           Style="{StaticResource LoginButtonStyle}" 
                           MinWidth="120" Margin="0,0,10,0"/>
                    <Button Content="THOÁT" 
                           Command="{Binding ExitCommand}"
                           Style="{StaticResource LoginButtonStyle}" 
                           Background="#95A5A6"
                           MinWidth="120" Margin="10,0,0,0"/>
                </StackPanel>

                <!-- Status Message -->
                <TextBlock Text="{Binding StatusMessage}" 
                          Foreground="#3498DB" FontSize="11"
                          HorizontalAlignment="Center" Margin="0,15,0,0"
                          Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                <!-- Loading Indicator -->
                <ProgressBar Height="4" IsIndeterminate="True" 
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            Margin="0,10,0,0"/>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#F8F9FA" CornerRadius="0,0,13,13" Height="40">
                <TextBlock Text="© 2024 ERP System. Phiên bản 1.0" 
                          Foreground="#6C757D" FontSize="11"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>