@inject CoreMVC.BL.Interfaces.ILanguageService _langguage;

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CoreMVC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CoreMVC.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <form id="langForm" method="post" asp-controller="Home" asp-action="SetLanguage">

            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
        </form>
        <div class="d-flex align-items-center language-switch">
            <a href=""><img src="~/assets/svg/Japan.svg" id="btn-language-jp" class="p-rg-10" alt="SVG Image"></a>
            <div class="divider  "></div>
            <a href=""><img src="~/assets/svg/Vietnam.svg" id="btn-language-vn" class="p-l-10" alt="SVG Image"></a>
        </div>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">CoreMVC</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            @* <span>@Localize("DAS-LBL-022")</span> *@
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Air">Air</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-1">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - CoreMVC - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

<script>
        // change language to jp
    $('#btn-language-jp').on("click", function () {
        $.ajax({
            url: "/change-language",
            type: "POST",
            data: JSON.stringify("ja-JP"),
            contentType: "application/json",
            beforeSend: function () {
            },
            success: function (data) {
                window.location.reload();
            },
            error: function (e) {
                console.log(e);
            }
        });
    });
    // change language to vi
    $('#btn-language-vn').on("click", function () {
        $.ajax({
            url: "/change-language",
            type: "POST",
            data: JSON.stringify("vi-VN"),
            contentType: "application/json",
            beforeSend: function () {
            },
            success: function (data) {
                window.location.reload();
            },
            error: function (e) {
                console.log(e);
            }
        });
    });
</script>

</html>
