<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Primary Colors -->
    <Color x:Key="PrimaryBlueColor">#FF007ACC</Color>
    <Color x:Key="PrimaryBlueHoverColor">#FF00BCF2</Color>
    <Color x:Key="PrimaryBluePressedColor">#FF005A9E</Color>

    <!-- Background Colors -->
    <Color x:Key="WindowBackgroundColor">#FF2D2D30</Color>
    <Color x:Key="ControlBackgroundColor">#FF3E3E42</Color>
    <Color x:Key="DisabledBackgroundColor">#FF666666</Color>

    <!-- Text Colors -->
    <Color x:Key="PrimaryTextColor">White</Color>
    <Color x:Key="SecondaryTextColor">#FF888888</Color>
    <Color x:Key="LinkTextColor">#FF007ACC</Color>

    <!-- Border Colors -->
    <Color x:Key="PrimaryBorderColor">#FF007ACC</Color>
    <Color x:Key="FocusBorderColor">#FF00BCF2</Color>

    <!-- Effect Colors -->
    <Color x:Key="ShadowColor">#FF007ACC</Color>

    <!-- SolidColorBrush Resources -->
    <SolidColorBrush x:Key="PrimaryBlueBrush" Color="{StaticResource PrimaryBlueColor}"/>
    <SolidColorBrush x:Key="PrimaryBlueHoverBrush" Color="{StaticResource PrimaryBlueHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryBluePressedBrush" Color="{StaticResource PrimaryBluePressedColor}"/>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{StaticResource ControlBackgroundColor}"/>
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="{StaticResource DisabledBackgroundColor}"/>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="LinkTextBrush" Color="{StaticResource LinkTextColor}"/>

    <SolidColorBrush x:Key="PrimaryBorderBrush" Color="{StaticResource PrimaryBorderColor}"/>
    <SolidColorBrush x:Key="FocusBorderBrush" Color="{StaticResource FocusBorderColor}"/>

    <!-- Gradient Brushes -->
    <LinearGradientBrush x:Key="ButtonGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource PrimaryBlueColor}" Offset="0"/>
        <GradientStop Color="{StaticResource PrimaryBluePressedColor}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ButtonHoverGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource PrimaryBlueHoverColor}" Offset="0"/>
        <GradientStop Color="{StaticResource PrimaryBlueColor}" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>