@{
    List<MstUnit> units = (List<MstUnit>)Model.Units;
}
<style>
    .component-unit .unit1 {
        top: 57%;
        left: 64%;
    }

    .component-unit .unit2 {
        top: 71%;
        left: 59%;
    }

    .component-unit .unit3 {
        top: 57%;
        left: 52%;
    }

    .component-unit .unit4 {
        top: 71%;
        left: 47%;
    }

    .component-unit .unit5 {
        top: 57%;
        left: 39%;
    }

    .component-unit .unit6 {
        top: 71%;
        left: 34%;
    }

    .myLine {
        position: absolute;
        width: 1px;
        height: 50%;
        background-color: #FCB25B;
        left: 50%;
    }

    .component-unit .unit-total {
        top: 4.5%;
        left: 3%;
    }

    .component-unit .unit-avg {
        top: 9.5%;
        left: 3%;
    }

    .unit2 .myLine-top {
        top: -50%;
    }

    .unit4 .myLine-top {
        top: -50%;
    }

    .unit6 .myLine-top {
        top: -50%;
    }

    .min-width-box {
        min-width: 320px;
    }

    .component-unit .note-performane {
        top: 15.5%;
        left: 3%;
        background-color: #F2F4F7;
        color: #2E4374 !important;
        padding-top: 7px;
        padding-bottom: 7px;
    }
</style>

<img class="img-visual w-100 h-100 img-visual" src="~/assets/img/Air.jpg" alt="Image" id="logo" />
<div class="position-absolute start-0 top-0 align-content-center text-white component-unit img-visual-layout" id="air-conditioner">
    @for (int i = 0; i < units.Count; i++)
    {
        <div class="text-center  shape-content  position-absolute shape-title outer-div @units[i].unit_code">
            <span class="inner-span fs-18 fw-medium" id="@units[i].unit_code"> </span><span class="fs-14 fw-medium"> @Localize("DAS-LBL-010")</span>
            <div class="myLine myLine-top"></div>
        </div>

    }
    <div class="text-center  shape-content position-absolute  shape-title  unit-total  min-width-box">
        <span class="d-inline-block fw-medium"> @Localize("COM-LBL-014") : <span id="index-total"></span> <span class="fs-14 fw-normal">@Localize("DAS-LBL-010")</span></span>
    </div>
    <div class="text-center  shape-content position-absolute shape-title  unit-avg min-width-box">
        <span class="d-inline-block fw-medium"> @Localize("COM-LBL-013") : <span id="index-avg"></span> <span class="fs-14 fw-normal">@Localize("DAS-LBL-010")</span></span>
    </div>
    <div class="text-center  shape-content position-absolute shape-title  note-performane text-black min-width-box">
        <div>
            <span class="d-inline-block fw-medium fs-18"> @Localize("COM-LBL-028") </span>

        </div>
        <div class="d-flex flex-row justify-content-center align-content-center fs-16">
            <div class="pe-3">
                <span class="">0 ~ 79%</span>
                <a><img src="~/assets/svg/ArrowGreen.svg" alt="SVG Image"></a>
            </div>
            <div class="pe-3">
                <span class="">80 ~ 99%</span>
                <a><img src="~/assets/svg/ArrowOrange.svg" alt="SVG Image"></a>
            </div>
            <div class="pe-3">
                <span class="">100%~</span>
                <a><img src="~/assets/svg/ArrowRed.svg" alt="SVG Image"></a>
            </div>

        </div>
    </div>
    <div class="loadingio-spinner-rolling-3cfcfh1ostx " id="visual-loading">
        <div class="ldio-cfo3yb5owxe">
            <div></div>
        </div>
    </div>
</div>

<script>
    
</script>