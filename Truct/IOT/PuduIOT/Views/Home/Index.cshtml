<style>
    .component-unit .unit-total {
        top: 4.5%;
        left: 2%;
    }

    .component-unit .unit-avg {
        top: 25.5%;
        left: 2%;
    }

    .component-unit .unitAir {
        top: 4.5%;
        left: 25%;
        background-color: #DFBDCF;
    }

    .component-unit .azone {
        top: 47%;
        left: 46%;
        background-color: #FBF8A1;
    }

    .component-unit .bzone {
        top: 31%;
        left: 63%;
        background-color: #FBF8A1;
    }

    .component-unit .czone {
        top: 6%;
        left: 74%;
        background-color: #FBF8A1;
    }

    .component-unit .unitPac {
        top: 50%;
        right: 2%;
        background-color: #90EFF5;
    }

    .myLine {
        position: absolute;
        width: 6px;
        height: 100%;
        background-color: #FCB25B;
        left: 50%;
        transform: translateX(-50%);
        transform: rotate(11deg);
    }

    .line-air {
        position: absolute;
        width: 6px;
        height: 74px;
        background-color: #FCB25B;
        right: -19px;
        transform: rotate(-22deg);
        top: 60px;
    }

    .line-azone {
        position: absolute;
        width: 6px;
        height: 133px;
        background-color: #FCB25B;
        left: 82px;
        transform: rotate(147deg);
        top: -124px;
    }

    .line-bzone {
        position: absolute;
        width: 6px;
        height: 230px;
        background-color: #FCB25B;
        left: -106px;
        transform: rotate(120deg);
        top: -133px;
    }

    .line-czone {
        position: absolute;
        width: 6px;
        height: 360px;
        background-color: #FCB25B;
        left: -181px;
        transform: rotate(80deg);
        top: -126px;
    }

    .outer-div {
        font-size: 30px;
        padding: 10px;
    }

    .fs-38 {
        font-size: 36px !important;
        line-height: 45px;
    }

    .fs-30 {
        font-size: 28px !important;
        line-height: 34px;
    }

    .Chart {
        bottom: 5%;
        right: 2%;
        background-color: white;
    }

    .btn-update {
        bottom: 20px;
        left: 22px;
    }

        .btn-update button {
            background: #80807B;
            border: 2px solid #80807B;
            color: #b7b9cc;
            font-size: 18px;
            line-height: 21px;
            letter-spacing: 0.15000000596046448px;
            text-align: center;
            width: 183px;
            height: 47px;
        }

            .btn-update button:hover {
                color: white;
            }

    .min-width-box {
        min-width: 420px;
    }

    .robot-grid {
        display: grid;
        grid-template-columns: repeat(3, 580px); /* 3 cột, mỗi cột rộng 200px */
        justify-content: center; /* Căn giữa toàn bộ grid */
        gap: 30px; /* Khoảng cách giữa các cột và hàng là 200px */
        margin-top: 15px;
        color: black;
    }

    .robot-card {
        background: #fff;
        border-radius: 8px;
        padding: 15px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        text-align: center;
    }
</style>

