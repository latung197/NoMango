                    <!-- Hình ảnh robot -->
                    <div class="col-md-4 text-center p-3">
                        <img id="robotImage" alt="Lỗi tải ảnh"
                             class="img-fluid rounded-3 border"
                             style="max-height: 500px; object-fit: cover;" />
                    </div>

                    <!-- Thông tin robot -->
                    <div class="col-md-8 p-3">

                        <h4 class="fw-bold text-primary" id="robotName"></h4>
                        <div class="row text-start">
                            <div class="col-4 fw-bold">Mac:</div>
                            <div class="col-8"><span id="robotMac"></span></div>
                            <div class="col-4 fw-bold">Pin:</div>
                            <div class="col-8"><span id="robotBattery"></span><span>%</span></div>
                            <div class="col-4 fw-bold">Trạng thái:</div>
                            <div class="col-8">
                                <span id="robotIs_online">
                                </span>
                            </div>
                            <div class="col-4 fw-bold">Trạng thái hoạt động:</div>
                            <div class="col-8">
                                <span id="robotWorkMes"></span>
                            </div>

                            <div class="col-4 fw-bold">Bản đồ:</div>
                            <div class="col-8"><span id="robotMap"></span></div>
                        </div>

                        <div class="mt-3">
                            <h5 class="fw-bold">Chức năng nhanh:</h5>
                            <div id="buttonList" class="d-flex flex-wrap gap-2"></div>
                        </div>

                    </div>
                    <div class="modal-body" id="robotDetailContent">  </div>
                </div>

            </div>

            <div class="modal-footer align-content-center justify-content-center pt-0 btn-hover">
            </div>
        </div>
    </div>
</div>


<script>

    const buttons = [
        { text: "Dừng", action: () => callApi(currentRobotSN, "stop") },
        { text: "Sạc", action: () => alert("Robot đi sạc") },
        { text: "Trở về", action: () => alert("Robot trở về trạm") }
    ];

    const buttonList = document.getElementById("buttonList");

    // Tự động sinh button
    buttons.forEach(btn => {
        const button = document.createElement("button");
        button.className = "btn btn-primary btn-sm"; // Bootstrap style
        button.innerText = btn.text;
        button.onclick = btn.action;
        buttonList.appendChild(button);
    });

        // Hàm gọi API
    function callApi(sn, action) {
      // Ví dụ gọi API /changing?sn=...
      fetch(`/changing?sn=${sn}`)
        .then(resp => {
          if (!resp.ok) throw new Error("Không gọi được API");
          return resp.json();
        })
        .then(data => {
          console.log("Dữ liệu trả về:", data);
          alert(`Ảnh robot: ${data.imgName}`);
          // ở đây bạn có thể làm gì với data.imgName tuỳ ý
        })
        .catch(err => {
          console.error(err);
          alert("Có lỗi khi gọi API");
        });
    }

    function electricSaveChanges() {
        var numericValue = document.getElementById('electricInput').value;

        if (numericValue == '')
            alert(languageResource['E-010'], 'danger');
        var data = {
            Key: 'ElectricCost',
            Value: parseFloat(numericValue)
        }

        $.ajax({
            url: "update-electric-cost",
            type: "POST",
            data: data,
            beforeSend: function () {
            },

            success: function (data) {

                languageResource['ElectricCost'] = parseFloat(numericValue);
            },
            error: function (e) {
                loading.style.display = "none";
                console.log(e);
            }
        });

    }


</script>
<script src="~/js/visualization.js" asp-appe nd-version="true"></script>