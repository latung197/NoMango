 <div class="modal fade" id="updateElectricCost" tabindex="-1" aria-labelledby="updateElectricCostLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header pb-0">
                <span class="modal-title fs-16 fw-medium" id="updateElectricCostLabel">@Localize("COM-LBL-027") </span>
                <button type="button" class="border-0 bg-white position-absolute" data-bs-dismiss="modal" aria-label="Close"><img src="~/assets/svg/Close.svg" id="menuToggleCollapse" alt="SVG Image"></button>
            </div>
            <div class="modal-body d-flex">
                <input type="text" id="electricInput" onpaste="handlePaste(event)" class="form-control" on onkeypress="return (event.charCode == 8 || event.charCode == 0 || event.charCode == 13) ? null : event.charCode >= 48 && event.charCode <= 57 || event.charCode == 46">
            </div>
            <div class="modal-footer align-content-center justify-content-center pt-0 btn-hover">
                <button type="button" class=" btn-save-change fw-700" data-bs-dismiss="modal" onclick="electricSaveChanges()">
                    @Localize("DAS-LBL-025")
                    <img src="~/assets/svg/Checkmark.svg" id="" alt="SVG Image">
                </button>
            </div>
        </div>
    </div>

</div>

<div class="modal fade" id="robotModal" tabindex="-1" aria-labelledby="robotModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="robotModalLabel">Chi tiết robot</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body" id="robotDetailContent">
                <!-- Nội dung chi tiết sẽ được load ở đây -->
                <div class="text-center">Đang tải...</div>
            </div>
        </div>
    </div>
</div>


<script>


    function electricSaveChanges() {
        var numericValue = document.getElementById('electricInput').value;

        if (numericValue == '')
            alert(languageResource['E-010'], 'danger');
        var data = {
            Key: 'ElectricCost',
            Value: parseFloat(numericValue)
        }

        $.ajax({
            url: "update-electric-cost",
            type: "POST",
            data: data,
            beforeSend: function () {
            },

            success: function (data) {

                languageResource['ElectricCost'] = parseFloat(numericValue);
            },
            error: function (e) {
                loading.style.display = "none";
                console.log(e);
            }
        });

    }

    function loadRobotDetails(id) {
        document.getElementById('robotDetailContent').innerHTML = "<div class='text-center'>Đang tải...</div>";

        fetch(`/Home/DetailsPartial/${id}`)
            .then(response => response.text())
            .then(html => {
                document.getElementById('robotDetailContent').innerHTML = html;
            })
            .catch(err => {
                document.getElementById('robotDetailContent').innerHTML = "<div class='text-danger'>Lỗi tải dữ liệu</div>";
            });
    }
</script>
