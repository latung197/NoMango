                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="modal-body" id="robotDetailContent">  </div>
                </div>

            </div>

            <div class="modal-footer align-content-center justify-content-center pt-0 btn-hover">
            </div>
        </div>
    </div>
</div>


<script>

    const buttons = [
        { text: "Sạc", css: "btn-charge", action: () => reCharge(currentRobotSN, "Robot đi sạc") },
        { text: "Hủy lệnh", css: "btn-cancel", action: () => CancelAllTasks(currentTaskIds) },
        { text: "Thực hiện lệnh", css: "btn-action", id: "btnThucHien", action: () => callRobotWithSelected(currentRobotSN) }
    ];


    const buttonList = document.getElementById("buttonList");
    buttonList.innerHTML = ""; // clear trước
    buttons.forEach(b => {
        const btn = document.createElement("button");
        btn.className = `btn btn-custom ${b.css}`;
        btn.innerText = b.text;
        if (b.id) btn.id = b.id;
        btn.onclick = b.action;
        buttonList.appendChild(btn);
    });

    function CancelAllTasks(taskIds) {
        taskIds.forEach(id => {
            CancelTask(id);
        });
        currentTaskIds = [];
        selectedPoints = [];
        const buttonListRight = document.getElementById("buttonListRight");
        buttonListRight.innerHTML = "";
        const btn = document.getElementById('btnThucHien');
        if (btn) {
            btn.disabled = false;          // 🔒 khóa nút   
        }
        const vt = document.getElementById('vitri');
        if (vt) {
            vt.innerText = ``;
        }
    }

    function CancelTask(taskId){
        fetch("/cancelTask", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                taskId: taskId
            })
        })
            .then(res => res.json())
            .then(serverRes => {
                // serverRes.result là chuỗi JSON
                let parsed = JSON.parse(serverRes.result); // parse lần nữa
                console.log("Parsed:", parsed);
            })
            .catch(err => { console.error("callRobot error", err); 
                alert("Có lỗi khi kết nối API");
});
    }

        // Hàm gọi API
    function reCharge(sn, action) {
      // Ví dụ gọi API /changing?sn=...
        fetch(`/reCharge?sn=${sn}`)
        .then(resp => {
          if (!resp.ok) throw new Error("Không gọi được API");
          return resp.json();
        })
        .then(data => {
          console.log("Dữ liệu trả về:", data);
          //alert(`Ảnh robot: ${data.imgName}`);
          // ở đây bạn có thể làm gì với data.imgName tuỳ ý
        })
        .catch(err => {
          console.error(err);
          alert("Có lỗi khi gọi API");
        });
    }




</script>
