@model PuduIOT.Models.MstRobotInfor

<div class="row p-3">
    <div class="col-4 text-center">
        <img src="@Model.ImgName" alt="@Model.Name" class="img-fluid rounded shadow" />
    </div>
    <div class="col-8">
        <h4 class="fw-bold">@Model.Name</h4>
        <p><strong>Trạng thái:</strong> @Model.Sn</p>
        <p><strong>Serial:</strong> @Model.Sn</p>
        <p><strong>Pin:</strong> @Model.Name %</p>
    </div>
</div>
