                                    const options = {
                                        year: 'numeric',
                                        month: 'numeric',
                                        day: 'numeric',
                                        hour: '2-digit',
                                        minute: '2-digit',
                                        hour12: false
                                    };
                                    if (cultureName === 'vi-VN') {
                                        var formatDate = currentDate.toLocaleString(cultureName, options).replace(',', '').split(' ');
