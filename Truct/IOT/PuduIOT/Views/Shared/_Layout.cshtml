<script>
    function focusInput(id) {
        // Focus on the input field when the icon is clicked
        document.getElementById(id).focus();
    }
    var timeRange = {
        dayChart: [],
        monthChart: [],
        yearChart: [],
        hourChart: []
    }
    var unitChecked = {
        dayUnit: [],
        monthUnit: [],
        yearUnit: [],
        hourUnit: []
    }

    var laneguageNotice = @Html.Raw(Json.Serialize(laneguageNotice));
    var configuration = @Html.Raw(Json.Serialize(configuration));

    var languageResource = {};
    laneguageNotice.forEach((item) => {
        languageResource[item['item_code']] = item['display_name'];
    });

    configuration.forEach((item) => {
        languageResource[item['key']] = item['value'];
    });

    const password = languageResource['Password'];


    const dayChartId = '#chartToday';
    const monthChartId = '#chartMonth';
    const yearChartId = '#chartYear';
    const hourChartId = '#chartHour';

    document.getElementById("goToHomePage").addEventListener("click", function () {
        window.location.href = '@Url.Action("Index", "Home")';
    });

    // change language to jp
    $('#btn-language-jp').on("click", function () {
        $.ajax({
            url: "/change-language",
            type: "POST",
            data: JSON.stringify("ja-JP"),
            contentType: "application/json",
            beforeSend: function () {
            },
            success: function (data) {
                window.location.reload();
            },
            error: function (e) {
                console.log(e);
            }
        });
    });
    // change language to vi
    $('#btn-language-vn').on("click", function () {
        $.ajax({
            url: "/change-language",
            type: "POST",
            data: JSON.stringify("vi-VN"),
            contentType: "application/json",
            beforeSend: function () {
            },
            success: function (data) {
                window.location.reload();
            },
            error: function (e) {
                console.log(e);
            }
        });
    });

    function showLoginSuccessModal() {
        $('.modal-backdrop').remove();
        $('#loginModal').modal('hide');
        if (window.location.pathname === '/')
            $('#updateElectricCost').modal('show');
        else
            $('#updateUnitModal').modal('show');

    }

    function login() {
        var pass = document.getElementById('password');
        if (pass.value === '') alert(languageResource['E-009'], 'danger');
        else

            if (pass.value !== password) {
                alert(languageResource['E-008'], 'danger');
            }
            else {
                showLoginSuccessModal();
            }
        pass.value = '';
    }


    function localStorageInsert(key, value) {
        localStorage.setItem(key, JSON.stringify(value));
    }

    function localStorageRead(key) {
        var storedKey = JSON.parse(localStorage.getItem(key));
        return storedKey;
    }

    function clickSideBar(e) {

        if (e.currentTarget.classList.contains('collapsed'))
            localStorageInsert(e.currentTarget.id, 'false')
        else
            localStorageInsert(e.currentTarget.id, 'true')
    }

    function focusSideBarItem(id) {
        var resource = document.getElementById(id);
        if (resource !== null)
            resource.classList.add('focus');

    }

    function showSideBarItem(id) {
        var parent = document.getElementById(id.split('-')[0] + '-collapse');
        var button = document.getElementById(id.split('-')[0] + '-btn');
        if (parent === null) return;
        button.setAttribute('aria-expanded', 'true');
        parent.classList.toggle('show')
    }

    $(document).ready(function () {

        var isLine = localStorageRead('line-btn');
        var isPac = localStorageRead('pac-btn');
        var isAir = localStorageRead('air-btn');
        if (isLine === 'true') {
            showSideBarItem('line');
        }
        if (isPac === 'true') {
            showSideBarItem('pac');
        }
        if (isAir === 'true') {
            showSideBarItem('air');
        }
        var id = '@ViewBag.Resource';
        focusSideBarItem(id)
    });

</script>
<script src="~/assets/bootstrap/js/theme.js"></script>
<script src="~/js/signalr/dist/browser/signalr.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

