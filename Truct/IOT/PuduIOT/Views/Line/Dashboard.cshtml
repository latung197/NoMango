@{
    List<MstUnit> units = (List<MstUnit>)Model.Units;  //3:  electric cabinet
}
<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />

<div class="text-black">
    <div class=" form-group  p-2 card " id="checkbox-group">
        <div class="card-title">
            <span class="fw-bold text-capitalize">

                @Localize("DAS-LBL-005")

            </span>
        </div>
        <div class="d-flex flex-row gap pb-2 ">
            <div class="form-check">
                <input class="form-check-input all-zone " type="checkbox" id="selectAll" checked>
                <label class="form-check-label fw-medium fs-14" for="selectAll">@Localize("DAS-LBL-004")</label>
            </div>
            <div class="form-check">
                <input class="form-check-input A-zone" type="checkbox" id="AZone" checked>
                <label class="form-check-label fw-medium fs-14" for="AZone">@Localize("COM-LBL-009")</label>
            </div>
            <div class="form-check">
                <input class="form-check-input B-zone" type="checkbox" id="BZone" checked>
                <label class="form-check-label fw-medium fs-14" for="BZone">@Localize("COM-LBL-010")</label>
            </div>
            <div class="form-check">
                <input class="form-check-input C-zone" type="checkbox" id="CZone" checked>
                <label class="form-check-label fw-medium fs-14" for="CZone">@Localize("COM-LBL-011")</label>
            </div>
        </div>

        <div class="d-flex flex-column flex-wrap form-checkbox" id="checkboxContainer">
            @for (int i = 0; i < units.Count; i++)
            {
                <div class="form-check fw-normal">
                    <input class="form-check-input checkbox-child @units[i].location-zone" type="checkbox" id="@units[i].unit_code" checked>
                    <label class="form-check-label label-checkbox-child" for="@units[i].unit_code">@Localize($"{units[i].item_code}")<span class="value" id="for-@units[i].unit_code"></span><span class="fs-10"> @Localize("DAS-LBL-010")</span></label>
                </div>
            }

        </div>
        <div class="loadingio-spinner-rolling-3cfcfh1ostx " id="checkbox-loading">
            <div class="ldio-cfo3yb5owxe">
                <div></div>
            </div>
        </div>
    </div>
    <partial name="_dashboard"  />

</div>
<script>
    var units = @Json.Serialize(units);
    var checkboxGroup = document.getElementById('checkbox-group')
    var container = document.getElementById('container')
    var chartHeight = (container.offsetHeight - 40 - checkboxGroup.offsetHeight - 20 - 11) / 2 - 56;
    var chartWidth = (container.offsetWidth - 40 - 10) / 2;
    var table = document.getElementById("container-table");

    // JavaScript to handle the "Select All" checkbox
    var selectAll = document.getElementById('selectAll');
    var aZone = document.getElementById('AZone');
    var bZone = document.getElementById('BZone');
    var cZone = document.getElementById('CZone');
    var checkboxes = document.querySelectorAll('.checkbox-child');
    var checkboxesAZone = document.querySelectorAll('#checkboxContainer .A-zone');
    var checkboxesBZone = document.querySelectorAll('#checkboxContainer .B-zone');
    var checkboxesCZone = document.querySelectorAll('#checkboxContainer .C-zone');
    var labels = document.querySelectorAll('.label-change');

    selectAll.addEventListener('change', function () {
        aZone.checked = bZone.checked = cZone.checked = selectAll.checked
        checkboxes.forEach(function (checkbox) {
            checkbox.checked = selectAll.checked;
        });

    });


    aZone.addEventListener('change', function () {
        var unitCodes = units.filter(u => u.location === "A").map(u => u.unit_code);

        if (!aZone.checked || !bZone.checked || !cZone.checked) selectAll.checked = false;
        else selectAll.checked = true;

        checkboxes.forEach(function (checkbox) {
            if (unitCodes.includes(checkbox.id))
                checkbox.checked = aZone.checked;

        });

    });

    bZone.addEventListener('change', function () {
        var unitCodes = units.filter(u => u.location === "B").map(u => u.unit_code);

        if (!aZone.checked || !bZone.checked || !cZone.checked) selectAll.checked = false;
        else selectAll.checked = true;

        checkboxes.forEach(function (checkbox) {
            if (unitCodes.includes(checkbox.id))
                checkbox.checked = bZone.checked;

        });

    });

    cZone.addEventListener('change', function () {
        var unitCodes = units.filter(u => u.location === "C").map(u => u.unit_code);

        if (!aZone.checked || !bZone.checked || !cZone.checked) selectAll.checked = false;
        else selectAll.checked = true;

        checkboxes.forEach(function (checkbox) {
            if (unitCodes.includes(checkbox.id))
                checkbox.checked = cZone.checked;

        });

    });

    checkboxes.forEach(function (checkbox) {
        checkbox.addEventListener('change', function () {

            var aChecked = true;
            checkboxesAZone.forEach(function (checkbox) {
                if (!checkbox.checked) {
                    aChecked = false;
                }
            });
            aZone.checked = aChecked;

            var bChecked = true;
            checkboxesBZone.forEach(function (checkbox) {
                if (!checkbox.checked) {
                    bChecked = false;
                }
            });
            bZone.checked = bChecked;

            var cChecked = true;
            checkboxesCZone.forEach(function (checkbox) {
                if (!checkbox.checked) {
                    cChecked = false;
                }
            });
            cZone.checked = cChecked;

            if (aChecked && bChecked && cChecked) selectAll.checked = true;
            else selectAll.checked = false;



        });
    });




</script>
<script src="~/js/dashboard.js" asp-append-version="true"></script>
<script src="~/js/toolbar_search.js" asp-append-version="true"></script>
