tests {
  test("should receive response data", function() {
    const data = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(data).to.be.a('string');
    expect(data).to.include("Hệ thống quản lý xuất hàng");
    expect(data).to.include("V1");
    expect(data).to.include("2024");
  });
}

